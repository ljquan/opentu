# Template only. No application scripts automatically load this file.
# Configure server values in Vercel; never put secrets in VITE_* variables.
NODE_ENV=production
POSTGRES_URL=
# Use postgres for a standard PostgreSQL server; default remains Neon.
OPENTU_DATABASE_DRIVER=neon
OPENTU_PROVIDER_ENCRYPTION_KEY=
CRON_SECRET=
TUZI_SESSION_API_BASE_URL=https://api.tu-zi.com
# Independent account deployment. HTTPS is required except SSH localhost staging.
OPENTU_AUTH_MODE=local
OPENTU_TRUST_PROXY=true
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
OPENTU_REGISTRATION_ENABLED=false
VITE_OPENTU_MANAGED_GENERATION=true

# Keep false until ALL launch gates in docs/managed-free-launch.md pass.
OPENTU_PUBLIC_GENERATION_ENABLED=false
VITE_OPENTU_SERVER_CATALOG=true
OPENTU_GENERATION_GLOBAL_CONCURRENCY=4
OPENTU_GENERATION_PROVIDER_CONCURRENCY=2
OPENTU_GENERATION_USER_CONCURRENCY=1
OPENTU_GENERATION_GLOBAL_DAILY_LIMIT=100
OPENTU_GENERATION_USER_DAILY_LIMIT=10
OPENTU_GENERATION_RATE_LIMIT_PER_MINUTE=12
