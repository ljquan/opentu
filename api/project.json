{
  "name": "api",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "api",
  "projectType": "application",
  "targets": {
    "typecheck": { "executor": "nx:run-commands", "options": { "command": "tsc -p api/tsconfig.json --noEmit" } },
    "test": { "executor": "nx:run-commands", "options": { "command": "vitest run --config api/vitest.config.ts" } },
    "lint": { "executor": "nx:run-commands", "options": { "command": "eslint api --ext .ts --no-ignore" } }
  }
}
