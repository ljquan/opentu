{
  "root": true,
  "ignorePatterns": ["**/*"],
  "plugins": ["@nx"],
  "overrides": [
    {
      "files": ["*.ts", "*.tsx", "*.js", "*.jsx"],
      "rules": {
        "@nx/enforce-module-boundaries": [
          "error",
          {
            "enforceBuildableLibDependency": true,
            "allow": ["tdesign-react", "tdesign-react/*"],
            "checkDynamicDependenciesExceptions": [
              "@drawnix/drawnix/runtime",
              "@drawnix/drawnix/ui-events",
              "@drawnix/drawnix/task-types",
              "@drawnix/drawnix/task-queue",
              "@drawnix/drawnix/sw-task-types",
              "@drawnix/drawnix/workflow-types",
              "@aitu/utils"
            ],
            "depConstraints": [
              {
                "sourceTag": "*",
                "onlyDependOnLibsWithTags": ["*"]
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["*.ts", "*.tsx"],
      "extends": ["plugin:@nx/typescript"],
      "rules": {}
    },
    {
      "files": ["*.js", "*.jsx"],
      "extends": ["plugin:@nx/javascript"],
      "rules": {}
    },
    {
      "files": ["*.spec.ts", "*.spec.tsx", "*.spec.js", "*.spec.jsx"],
      "env": {},
      "rules": {}
    }
  ]
}
