  "fields": {
    "mv": {
      "type": "string",
      "label": "模型版本",
      "description": "三个版本价格相同，按需要的风格选择。",
      "enum": [
        "chirp-v6",
        "chirp-v6-wild",
        "chirp-v6-mini"
      ],
      "default": "chirp-v6",
      "enumLabels": [
        "v6（默认，均衡）",
        "v6 Wild（风格更奔放）",
        "v6 Mini（更快）"
      ]
    },
    "custom": {
      "type": "boolean",
      "label": "自定义模式",
      "description": "关闭时你只需用一句话描述想要什么；开启时由你提供完整歌词。",
      "default": false
    },
    "gpt_description_prompt": {
      "type": "string",
      "label": "灵感描述",
      "description": "一句话描述想要的歌，例如「轻柔的 lo-fi 钢琴，雨夜」。关闭自定义模式时必填，最长 3000 字。"
    },
    "prompt": {
      "type": "string",
      "label": "歌词",
      "description": "完整歌词，最长 5000 字。可以用 [Verse]、[Chorus] 这类标记划分段落。"
    },
    "title": {
      "type": "string",
      "label": "标题",
      "description": "曲目标题，最长 80 字。"
    },
    "tags": {
      "type": "string",
      "label": "风格标签",
      "description": "想要的曲风，例如「lo-fi 钢琴, 舒缓, 雨声」，最长 1000 字。"
    },
    "negative_tags": {
      "type": "string",
      "label": "排除风格",
      "description": "不希望出现的曲风，用来避开某些方向。"
    },
    "style_weight": {
      "type": "number",
      "label": "风格贴合度",
      "description": "0 到 1。越高越贴近你写的风格标签，越低留给模型的发挥空间越大。"
    },
    "weirdness_constraint": {
      "type": "number",
      "label": "创意发散度",
      "description": "0 到 1。越高越出人意料，越低越接近常规写法。"
    },
    "audio_weight": {
      "type": "number",
      "label": "参考音频权重",
      "description": "0 到 1。调节参考音频对成品的影响程度。"
    },
    "vocal_gender": {
      "type": "string",
      "label": "人声性别",
      "description": "指定演唱者的嗓音性别。",
      "enum": [
        "Male",
        "Female"
      ],
      "enumLabels": [
        "男声",
        "女声"
      ]
    },
    "variety": {
      "type": "string",
      "label": "风格发散度",
      "description": "控制成品与指定风格的偏离程度，从完全贴合到大胆发挥。",
      "enum": [
        "off",
        "normal",
        "high",
        "extra",
        "max"
      ],
      "enumLabels": [
        "完全贴合",
        "均衡",
        "较为多变",
        "大胆发挥",
        "最大发散"
      ]
    },
    "max_mode": {
      "type": "boolean",
      "label": "最高质量模式",
      "description": "投入更多算力让整首歌前后更连贯。仅自定义模式有效，开启后价格翻倍。",
      "default": false
    },
    "model_id": {
      "type": "string",
      "label": "自建模型",
      "description": "用自建模型来生成，填创建模型结果里的 model_id。不能与 persona_id 同时使用。"
    },
    "audio_format": {
      "type": "string",
      "label": "输出格式",
      "description": "成品音频的格式，不填默认 mp3。",
      "enum": [
        "mp3",
        "m4a",
        "wav"
      ],
      "enumLabels": [
        "MP3（通用）",
        "M4A",
        "WAV（无损）"
      ]
    },
    "music_id": {
      "type": "string",
      "label": "源曲目",
      "description": "要处理的曲目，填之前生成结果里的 music_id。"
    },
    "keep_pitch": {
      "type": "boolean",
      "label": "保持音高",
      "description": "变速时保持原来的音调不变；关闭则音调会随速度升降。",
      "default": false
    },
    "speed_multiplier": {
      "type": "number",
      "label": "速度倍率",
      "description": "播放速度倍数，0.25 到 4 之间。1 为原速。",
      "default": 1
    },
    "duration": {
      "type": "integer",
      "label": "时长",
      "description": "成品时长，单位秒，10 到 360 之间。"
    },
    "persona_id": {
      "type": "string",
      "label": "指定音色",
      "description": "用之前创建好的音色来演唱，填音色 ID。仅自定义模式有效。"
    },
    "audio_urls": {
      "type": "array",
      "label": "音频地址列表",
      "description": "6 到 24 个公网可直接下载的音频地址。",
      "minItems": 6,
      "maxItems": 24,
      "items": {
        "type": "string"
      }
    },
    "name": {
      "type": "string",
      "label": "名称",
      "description": "给创建出来的音色或模型起个名字。"
    },
    "audio_url": {
      "type": "string",
      "label": "音频地址",
      "description": "公网可直接下载的音频地址，建议 8 分钟以内，支持 MP3 / WAV / M4A。"
    },
    "formats": {
      "type": "array",
      "label": "导出格式",
      "description": "要导出的音频格式，可以同时选多个。",
      "items": {
        "type": "string"
      }
    },
    "extend:custom": {
      "type": "boolean",
      "label": "自定义模式",
      "description": "关闭时你只需用一句话描述想要什么；开启时由你提供完整歌词。",
      "default": true
    },
    "auto_lyrics": {
      "type": "boolean",
      "label": "自动润色歌词",
      "description": "开启后会把你写的歌词改写得更适合演唱，仅自定义模式有效。",
      "default": false
    },
    "continue_at": {
      "type": "number",
      "label": "续写起点",
      "description": "从原曲的第几秒开始往下写，单位秒。"
    },
    "inspo:audio_urls": {
      "type": "array",
      "label": "音频地址列表",
      "description": "1 到 4 个公网可直接下载的参考音频地址。",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string"
      }
    },
    "lyrics_model": {
      "type": "string",
      "label": "歌词取向",
      "description": "选择歌词创作的取向。",
      "enum": [
        "classic",
        "remi"
      ],
      "default": "classic",
      "enumLabels": [
        "经典",
        "灵感"
      ]
    },
    "instrumental": {
      "type": "boolean",
      "label": "纯伴奏",
      "description": "开启后只出伴奏，不演唱歌词。",
      "default": false
    },
    "mashup_music_id": {
      "type": "array",
