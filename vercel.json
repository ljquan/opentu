{
  "buildCommand": "NODE_OPTIONS='--max-old-space-size=4096' pnpm run build:web",
  "outputDirectory": "dist/apps/web",
  "installCommand": "pnpm install --frozen-lockfile",
  "functions": {
    "api/generation/tasks.ts": { "maxDuration": 90 },
    "api/internal/generation-maintenance.ts": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/internal/generation-maintenance", "schedule": "*/5 * * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    }
  ],
  "framework": null,
  "rewrites": [
    {
      "source": "/__opentu_tuzi_proxy__/api/:path*",
      "destination": "https://api.tu-zi.com/:path*"
    },
    {
      "source": "/__opentu_tuzi_proxy__/apius/:path*",
      "destination": "https://apius.tu-zi.com/:path*"
    },
    {
      "source": "/__opentu_tuzi_proxy__/apicdn/:path*",
      "destination": "https://apicdn.tu-zi.com/:path*"
    },
    {
      "source": "/__opentu_tuzi_proxy__/sydney/:path*",
      "destination": "https://api.sydney-ai.com/:path*"
    },
    {
      "source": "/__opentu_tuzi_proxy__/ourzhishi/:path*",
      "destination": "https://api.ourzhishi.top/:path*"
    },
    {
      "source": "/__opentu_tuzi_proxy__/ourzhishi-sz/:path*",
      "destination": "https://apisz.ourzhishi.top/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/ai-image-generator.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/flowchart-maker.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/mindmap-maker.html",
      "destination": "/",
      "permanent": true
    }
  ]
}
